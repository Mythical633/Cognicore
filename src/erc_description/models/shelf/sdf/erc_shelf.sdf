<?xml version="1.0"?>
<sdf version="1.8">
  <model name="erc_shelf">
    <static>true</static>
    <link name="shelf_base_link">

      <visual name="base_link_shelf_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://erc_description/models/shelf/meshes/erc_base_shelf.STL</uri>
            
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <collision name="base_link_shelf_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://erc_description/models/shelf/meshes/erc_base_shelf.STL</uri>
            
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
