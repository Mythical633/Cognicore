<?xml version="1.0"?>
<sdf version="1.8">
  <model name="erc_colleciton_bin">
    <link name="collection_bin_base_link">

      <inertial>
        <pose>-0.000869450515234303 -0.0349219950638846 -2.95363168814333E-17 0 0 0</pose>
        <mass>4.70313898335195</mass>
        <inertia>
          <ixx>0.0896407437951023</ixx>
          <ixy>0.00627075393219412</ixy>
          <ixz>-5.70546165916065E-17</ixz>
          <iyy>0.223231929617035</iyy>
          <iyz>1.25985954159326E-17</iyz>
          <izz>0.175200579933907</izz>
        </inertia>
      </inertial>

      <visual name="base_link_collection_bin_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://erc_description/models/collection_bin/meshes/erc_base_collection_bin.STL</uri>
            
          </mesh>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>

      <collision name="base_link_collection_bin_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://erc_description/models/collection_bin/meshes/erc_base_collection_bin.STL</uri>
            
          </mesh>
        </geometry>
      </collision>

      <sensor name="bin_contact_sensor" type="contact">
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <contact>
          <collision>base_link_collection_bin_collision</collision>
        </contact>
      </sensor>

    </link>
  </model>
</sdf>
